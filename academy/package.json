{
  "name": "pstack-interactive-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content": "python3 scripts/build_content.py",
    "dev": "npm run content && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "npm run content && npm run typecheck && vite build && python3 scripts/validate_build.py",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run content && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.46.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "14.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
